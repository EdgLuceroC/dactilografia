# --- IA (opcional) ---------------------------------------------------------
# Sin esta variable la aplicación funciona igual: se ocultan los botones que
# generan textos y devoluciones con IA. Ver docs/ia.md.
#
# Opción A · función serverless incluida en api/ia.js (Vercel, Netlify, etc.)
VITE_IA_ENDPOINT=/api/ia
#
# Opción B · endpoint propio compatible con la API de Mensajes de Anthropic
# VITE_IA_ENDPOINT=https://mi-proxy.ejemplo.com/v1/messages

# Modelo pedido por el cliente. El backend puede ignorarlo o imponer el suyo.
VITE_IA_MODELO=claude-sonnet-5

# --- Solo para el backend (api/ia.js). Nunca se expone al navegador --------
# ANTHROPIC_API_KEY=sk-ant-...
# IA_MODELO=claude-sonnet-5
